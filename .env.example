# ============================================================
#  订单农业可信性 Agent - 环境变量模板
#
#  用法（每台机器各做一次）：
#      cp .env.example .env
#      然后按需修改
#
#  ⚠️ .env 已在 .gitignore 中，绝不入库
#  ⚠️ 两台机器的 .env 独立维护，凭证可以不同
#
#  本文件是 Windows 开发机与 Linux 主力机的"唯一差异点"：
#  只需要改「提供者选择」这组开关，业务代码零改动。
# ============================================================

# ---------------- 应用基础 ----------------
APP_NAME=agri-trust-agent
APP_ENV=development
APP_DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000
# 前端开发服务器地址（Vite 默认 5173），用于跨域放行
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------- 提供者选择（跨机差异的唯一入口）----------------
# 下面这些开关决定"用真实服务还是离线兜底实现"。
#
#   Windows 开发机（当前，无华为云凭证）  Linux 主力机（有凭证 + 显卡）
#   ----------------------------------    ----------------------------
#   LLM_PROVIDER=mock                     LLM_PROVIDER=pangu
#   OCR_PROVIDER=cloud                    OCR_PROVIDER=huawei
#   EMBEDDING_PROVIDER=hashing            EMBEDDING_PROVIDER=local
#   RERANK_PROVIDER=disabled              RERANK_PROVIDER=cloud
#   CONTRACT_STRUCTURER=rule              CONTRACT_STRUCTURER=llm
#   VECTOR_STORE_BACKEND=simple           VECTOR_STORE_BACKEND=chroma
#   CONTRACT_ESCALATION=auto              CONTRACT_ESCALATION=auto
#   SEARCH_PROVIDER=disabled              SEARCH_PROVIDER=tavily
#   ENTERPRISE_API_PROVIDER=fixture       ENTERPRISE_API_PROVIDER=qcc
#
# EMBEDDING_PROVIDER 三选一：
#   cloud    —— 云端 bge-m3（SiliconFlow）。无需显卡/权重，有网即可，见下方「云端向量化」
#   local    —— 本地 bge-m3。需 torch + 显卡（主力机）
#   hashing  —— 零依赖哈希向量。完全离线，语义效果最弱
#
# OCR_PROVIDER 三选一：
#   cloud    —— 云端视觉 OCR（SiliconFlow，模型 OCR_CLOUD_MODEL 可配）
#   huawei   —— 华为云文字识别（赛题要求的华为技术，需 AK/SK）
#   disabled —— 不启用。扫描件会返回明确告警；电子版 PDF 无需 OCR
#
LLM_PROVIDER=mock            # mock | pangu | deepseek
OCR_PROVIDER=disabled        # cloud | huawei | disabled
EMBEDDING_PROVIDER=hashing   # hashing | local | cloud
CONTRACT_STRUCTURER=rule     # rule | llm

# L1→L2 自动升级（解析质量门禁的一部分）
#   auto —— 默认。L1（规则抽取）命中触发条件时，自动用 LLM 重解析一遍，
#           并且**只在更完整时才采纳**，绝不用更差的结果覆盖更好的
#   触发条件：主体全缺 / 文档来自 OCR（图片·扫描件）/ 关键交易要素大面积缺失
#   off  —— 只跑 L1。无 LLM 凭证、或想严格控制调用量时使用
CONTRACT_ESCALATION=auto     # auto | off

# ---------------- 华为云 · 通用认证 ----------------
# 控制台 →「我的凭证」→「访问密钥」
HUAWEI_CLOUD_AK=
HUAWEI_CLOUD_SK=
HUAWEI_CLOUD_PROJECT_ID=
# 必须与所开通服务的区域一致，例如 cn-north-4
HUAWEI_CLOUD_REGION=cn-north-4

# ---------------- 华为云 · 盘古大模型 / ModelArts Studio ----------------
# 用于：合同解析（结构化）、履约模拟（风险推演）
# MaaS 提供 OpenAI 兼容接口，PANGU_BASE_URL 需包含版本路径，例如 https://xxx/v1
PANGU_BASE_URL=
PANGU_API_KEY=
PANGU_MODEL=

# ---------------- deepseek-flash（OpenAI 兼容 · tokenrhythm）----------------
# 与盘古同为 OpenAI /chat/completions 协议。配好凭证后设 LLM_PROVIDER=deepseek
# 即可用它替换盘古，作为项目的真实 LLM（合同抽取 / 履约风险定性分析）。
# BASE_URL / MODEL 有内置默认，可省略；API Key 只放 .env，绝不入库。
DEEPSEEK_BASE_URL=https://tokenrhythm.studio/v1
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=120

# ---------------- 华为云 · 文字识别 OCR ----------------
# 仅扫描件需要；电子版 PDF 自带文本层，无需 OCR
# 依赖上面的 AK/SK，且区域必须与 HUAWEI_CLOUD_REGION 配套
OCR_ENDPOINT=
OCR_MAX_RETRY=3

# ---------------- 企业核验（P1）----------------
# L1（信用代码校验位验算）纯本地计算，无需任何凭证。
# L2 工商数据走 Provider 层，两套实现：
#   fixture —— 内置虚构演示数据（data/fixtures/enterprise_fixture.json），离线兜底，默认
#   qcc     —— 企查查 MCP（真实工商数据），需 token
# 断网演示前请切回 fixture。
ENTERPRISE_API_PROVIDER=fixture
ENTERPRISE_API_BASE_URL=https://agent.qcc.com/mcp/company/stream
ENTERPRISE_API_KEY=
ENTERPRISE_TIMEOUT=60

# ---------------- 标准校验 · RAG（P0）----------------
# 无 torch 的机器用 hashing + simple（零依赖，开箱即用）
# 有显卡的机器换 local + chroma（语义效果更好）
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cuda
EMBEDDING_DIM_HASHING=512
RERANK_ENABLED=true
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_DEVICE=cuda
# 向量库后端：simple | chroma | milvus
VECTOR_STORE_BACKEND=simple
CHROMA_PERSIST_DIR=./data/chroma
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.03
# 模型下载走国内镜像，避免拉取失败
HF_ENDPOINT=https://hf-mirror.com
HF_HOME=./data/hf_cache

# ---------------- 云端向量化 / 重排 / 视觉OCR（SiliconFlow，OpenAI 兼容）----------------
# 用途：EMBEDDING_PROVIDER=cloud 时提供语义向量；RERANK_PROVIDER=cloud 时做精排；
#       OCR_PROVIDER=cloud 时提供视觉 OCR。
# 好处：不装 torch、不下载 2GB 权重，Windows 开发机也能得到真正的语义检索效果。
# ⚠️ 会把标准库语料与合同条款正文发往第三方，敏感合同请改用 local。
# ⚠️ 演示现场若断网，请把上面两个开关切回 hashing / disabled。
CLOUD_API_BASE_URL=https://api.siliconflow.cn/v1
CLOUD_API_KEY=
CLOUD_TIMEOUT=60
EMBEDDING_CLOUD_MODEL=BAAI/bge-m3
EMBEDDING_CLOUD_DIM=1024
EMBEDDING_CLOUD_BATCH_SIZE=32
# 重排：disabled | cloud
RERANK_PROVIDER=disabled

# ---------------- 云端视觉 OCR（与上面共用 Key）----------------
# PaddleOCR-VL 专为 OCR 训练，中文合同效果好；也可换 Qwen/Qwen2.5-VL 系列视觉模型
OCR_CLOUD_MODEL=PaddlePaddle/PaddleOCR-VL-1.5
OCR_CLOUD_TIMEOUT=120

# ---------------- 联网搜索（Tavily，仅 Agent 加深时用）----------------
# MCP Agent 在跑完本地四模块后，可再联网取证（企业违法记录 / 类案裁判 / 政策风险）。
# 走 Provider 层，业务模块不感知；REST 接口与前端都不依赖它。
#   disabled —— 默认。离线降级，返回空结果 + 明确说明，不伪造内容
#   tavily   —— 真实联网，需 TAVILY_API_KEY
# ⚠️ 会把查询关键词发往第三方。断网演示前请切回 disabled。
# ⚠️ 与 OpenCode 的 tavily 插件可共用同一把 key，但服务端只读 .env，不读用户目录配置。
SEARCH_PROVIDER=disabled     # disabled | tavily
TAVILY_API_KEY=
TAVILY_MAX_RESULTS=5
TAVILY_TIMEOUT=30

# ---------------- 存储 ----------------
# 结构化数据：默认 SQLite，后续可换 PostgreSQL
DATABASE_URL=sqlite:///./data/app.db
# 合同原件存储：local | minio
STORAGE_BACKEND=local
FILE_STORAGE_DIR=./data/uploads
# 标准库语料目录（标准校验模块的知识来源）
STANDARDS_DIR=./data/standards
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=contracts

# ---------------- 可选：缓存 / 队列 ----------------
REDIS_URL=

# ---------------- 网络代理（仅本地开发需要）----------------
# ⚠️ 比赛现场请务必清空，并提前完成依赖与模型的本地化
# ⚠️ Docker daemon 不读这些变量，需单独配置，见 docker-compose.yml 注释
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=
