# ============================================================
#  不入库清单
#  原则：凭证、环境产物、数据、模型一律不入库
# ============================================================

# ---- 凭证（最重要）----
.env
.env.local
.env.*.local
!.env.example

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# ---- Node / 前端 ----
node_modules/
dist/
dist-ssr/
.vite/
*.local

# ---- 数据与模型 ----
# 运行产物不入库：contracts（解析结果）/ uploads（合同原件，含用户隐私）
data/*
!data/.gitkeep
# 但知识库必须入库 —— 标准库与必备条款清单是本项目的核心资产，
# 不入库则换台机器就要重新整理（Linux 主力机需要它）
!data/standards/
# 企业核验演示数据（虚构企业，需随仓库分发，断网演示的兜底）
!data/fixtures/
# 裁判规则库（50 份判例提炼，履约模拟模块的运行时依赖，勿删）
!data/knowledge/
# 验收基准：示例合同（由 scripts/make_sample_contract.py 确定性生成，约 8KB）
!data/samples/

models/
*.db
*.sqlite3
*.pt
*.safetensors
*.onnx

# ---- IDE / 编辑器 ----
.idea/
.vscode/
*.swp
*.swo

# ---- Agent 工具链本地配置 ----
# MCP 客户端接入配置（含本机绝对路径，逐人不同）+ 插件原始输出
.pi/
.codebuddy/
.tavily/

# ---- 操作系统 ----
.DS_Store
Thumbs.db
desktop.ini

# ---- 日志与临时文件 ----
*.log
logs/
tmp/
temp/
